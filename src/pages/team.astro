---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { TeamMemberCard } from "@/components/react/TeamMemberCard";
import { getCollection } from "astro:content";

const teamMembers = await getCollection("team", ({ id }) => !id.startsWith("_template-"));
const currentTeam = teamMembers
    .filter((member) => !member.data.isPastMember)
    .sort((a, b) => a.data.order - b.data.order);
const pastTeam = teamMembers.filter((member) => member.data.isPastMember).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Team">
    <div class="space-y-16">
        {/* Page Header */}
        <div class="space-y-4 border-b border-border pb-8">
            <h1 class="text-4xl md:text-5xl font-display font-bold tracking-tighter uppercase text-foreground">
                Core Team
            </h1>
            <p class="text-muted-foreground font-mono max-w-2xl">The people behind AISOC.</p>
        </div>

        {/* Current Team Grid */}
        <section>
            {
                currentTeam.length > 0 ? (
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                        {currentTeam.map((member) => (
                            <TeamMemberCard client:load member={member} />
                        ))}
                    </div>
                ) : (
                    <div class="data-terminal text-center py-12 text-muted-foreground">[ NO_TEAM_MEMBERS_FOUND ]</div>
                )
            }
        </section>

        {/* Past Team Section (hidden if empty) */}
        {
            pastTeam.length > 0 && (
                <section class="space-y-6 border-t border-border pt-8">
                    <div>
                        <h2 class="text-2xl md:text-3xl font-display font-bold tracking-tighter uppercase text-foreground">
                            Past Exco Members
                        </h2>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                        {pastTeam.map((member) => (
                            <TeamMemberCard client:load member={member} />
                        ))}
                    </div>
                </section>
            )
        }
    </div>
</BaseLayout>
