---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { TeamMemberCard } from "@/components/react/TeamMemberCard";
import { getCollection } from "astro:content";
import { sortTeamMembers } from "@/lib/team";

const allMembers = await getCollection("team", ({ id }) => !id.startsWith("_template-"));

const currentExco = sortTeamMembers(allMembers.filter((member) => member.data.category === "exco"));
const currentMembers = sortTeamMembers(allMembers.filter((member) => member.data.category === "member"));
const alumni = sortTeamMembers(allMembers.filter((member) => member.data.category === "alumni"));
---

<BaseLayout title="Team">
    <div class="space-y-16">
        {/* Page Header */}
        <div class="space-y-4 border-b border-border pb-8">
            <h1 class="text-4xl md:text-5xl font-display font-bold tracking-tighter uppercase text-foreground">
                Core Team
            </h1>
            <p class="text-muted-foreground font-mono max-w-2xl">The people behind AISOC.</p>
        </div>

        {/* Current Executive Committee */}
        <section>
            {
                currentExco.length > 0 ? (
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                        {currentExco.map((member) => (
                            <TeamMemberCard client:load member={member} />
                        ))}
                    </div>
                ) : (
                    <div class="data-terminal text-center py-12 text-muted-foreground">[ NO_EXCO_MEMBERS_FOUND ]</div>
                )
            }
        </section>

        {/* Current Members */}
        {
            currentMembers.length > 0 && (
                <section class="space-y-6 border-t border-border pt-8">
                    <div>
                        <h2 class="text-2xl md:text-3xl font-display font-bold tracking-tighter uppercase text-foreground">
                            Members
                        </h2>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                        {currentMembers.map((member) => (
                            <TeamMemberCard client:load member={member} />
                        ))}
                    </div>
                </section>
            )
        }

        {/* Alumni (Past Exco + Past Members) */}
        {
            alumni.length > 0 && (
                <section class="space-y-6 border-t border-border pt-8">
                    <div>
                        <h2 class="text-2xl md:text-3xl font-display font-bold tracking-tighter uppercase text-foreground">
                            Alumni
                        </h2>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                        {alumni.map((member) => (
                            <TeamMemberCard client:load member={member} />
                        ))}
                    </div>
                </section>
            )
        }
    </div>
</BaseLayout>
